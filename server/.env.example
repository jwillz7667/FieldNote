# ──────────────────────────── Runtime ────────────────────────────
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
# Comma-separated allowed CORS origins. Native iOS doesn't need CORS,
# but /docs + any web tooling does. Use "*" only in development.
CORS_ORIGINS=*
LOG_LEVEL=info

# ──────────────────────── Postgres (Prisma) ──────────────────────
# Append ?connection_limit=N&pool_timeout=30 sized to worker concurrency.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldnote?schema=public&connection_limit=10

# ───────────────────────── Redis (BullMQ) ────────────────────────
REDIS_URL=redis://localhost:6379

# ────────────────────────── Cloudflare R2 ────────────────────────
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET=fieldnote
# Cloudflare:  https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# LocalStack (dev):  http://localhost:4566
R2_ENDPOINT=http://localhost:4566
# LocalStack/MinIO need path-style addressing; real R2 works with virtual-host too.
R2_FORCE_PATH_STYLE=true
# TTL (seconds) for presigned upload/download URLs. Generous PUT TTL survives slow field uploads.
R2_PRESIGN_PUT_TTL=3600
R2_PRESIGN_GET_TTL=900
# Days to retain raw audio after a job reaches READY (lifecycle hint; 0 disables).
AUDIO_RETENTION_DAYS=30

# ───────────────────────────── AI engine ─────────────────────────
# Transcription: "deepgram" (primary) or "openai" (alt). Provider chosen at boot.
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# OpenAI alt (transcription) — required only if TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Report compilation (DeepSeek — OpenAI-compatible function calling)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
REPORT_MODEL=deepseek-chat

# Pipeline guardrails
MAX_AUDIO_SECONDS=5400
WORKER_CONCURRENCY=2
STAGE_TIMEOUT_MS=180000
JOB_MAX_ATTEMPTS=3

# Set true to use deterministic mock AI providers (no external keys/cost).
# Auto-enabled when NODE_ENV=test.
USE_MOCK_AI=false

# ─────────────────────── Auth (Sign in with Apple) ───────────────
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.viralventures.fieldnote
# .p8 contents with literal "\n" escapes, or a real multiline PEM.
APPLE_PRIVATE_KEY=
# Bypass real Apple JWKS verification for local dev/testing ONLY. Never true in prod.
APPLE_AUTH_DEV_BYPASS=false

# JWT signing (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-000000000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ────────────────────────── Bull-Board (dev) ─────────────────────
# Basic-auth for the queue dashboard at /admin/queues. Disabled if unset.
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
