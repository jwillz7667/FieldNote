{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_liveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "HealthController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/auth/apple": {
      "post": {
        "operationId": "AuthController_signInWithApple",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleSignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto"
                }
              }
            }
          }
        },
        "summary": "Exchange an Apple identity token for app tokens.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto"
                }
              }
            }
          }
        },
        "summary": "Rotate tokens using a valid refresh token.",
        "tags": [
          "auth"
        ]
      }
    },
    "/jobs": {
      "get": {
        "operationId": "JobsController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor: the id of the last item from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List the current user's jobs (cursor-paginated).",
        "tags": [
          "jobs"
        ]
      },
      "post": {
        "operationId": "JobsController_create",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "De-dupes retried creates.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateJobResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a draft job; returns the job and a presigned audio upload URL.",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "JobsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a job with its report and (if READY) a presigned PDF URL.",
        "tags": [
          "jobs"
        ]
      },
      "patch": {
        "operationId": "JobsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateJobDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update label and/or edited report sections (last-write-wins).",
        "tags": [
          "jobs"
        ]
      },
      "delete": {
        "operationId": "JobsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Soft-delete a job and remove its R2 objects.",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{id}/process": {
      "post": {
        "operationId": "JobsController_process",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Mark audio uploaded and enqueue processing (idempotent).",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{id}/pdf": {
      "get": {
        "operationId": "JobsController_pdf",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfUrlDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a short-lived presigned URL for the rendered PDF.",
        "tags": [
          "jobs"
        ]
      }
    }
  },
  "info": {
    "title": "FieldNote API",
    "description": "Voice-to-report backend for field inspections.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "current host"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AppleSignInDto": {
        "type": "object",
        "properties": {
          "identityToken": {
            "type": "string",
            "description": "Apple's identity token (JWT) from ASAuthorizationAppleIDCredential."
          },
          "nonce": {
            "type": "string",
            "description": "Raw nonce the client set on the authorization request (replay protection)."
          },
          "email": {
            "type": "string",
            "description": "Email from the Apple credential (only present on first sign-in)."
          }
        },
        "required": [
          "identityToken"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "default": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds."
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "userId"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateJobDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Property address or label for the inspection.",
            "maxLength": 200
          }
        },
        "required": [
          "label"
        ]
      },
      "FindingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "maintenance",
              "repair",
              "safety"
            ]
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "text",
          "severity",
          "sortOrder"
        ]
      },
      "SectionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "sortOrder",
          "findings"
        ]
      },
      "JobDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "UPLOADING",
              "QUEUED",
              "TRANSCRIBING",
              "COMPILING",
              "RENDERING",
              "READY",
              "FAILED"
            ]
          },
          "transcript": {
            "type": "object",
            "nullable": true
          },
          "errorMessage": {
            "type": "object",
            "nullable": true,
            "description": "User-safe failure reason when status=FAILED."
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionDto"
            }
          },
          "pdfUrl": {
            "type": "object",
            "nullable": true,
            "description": "Presigned GET URL for the PDF (present when READY)."
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "status",
          "sections",
          "createdAt",
          "updatedAt"
        ]
      },
      "PresignedUploadDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number"
          }
        },
        "required": [
          "url",
          "key",
          "contentType",
          "expiresInSeconds"
        ]
      },
      "CreateJobResponseDto": {
        "type": "object",
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobDto"
          },
          "audioUploadUrl": {
            "description": "Presigned PUT for the audio file.",
            "allOf": [
              {
                "$ref": "#/components/schemas/PresignedUploadDto"
              }
            ]
          }
        },
        "required": [
          "job",
          "audioUploadUrl"
        ]
      },
      "UpdateFindingDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "maintenance",
              "repair",
              "safety"
            ]
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "text",
          "severity",
          "sortOrder"
        ]
      },
      "UpdateSectionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateFindingDto"
            }
          }
        },
        "required": [
          "title",
          "sortOrder",
          "findings"
        ]
      },
      "UpdateJobDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateSectionDto"
            }
          }
        }
      },
      "PdfUrlDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number"
          }
        },
        "required": [
          "url",
          "expiresInSeconds"
        ]
      }
    }
  }
}